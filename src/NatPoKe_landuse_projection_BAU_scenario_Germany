# Plot on a national level: Germany
# import Germany shapefile
library(rnaturalearth)
library(rnaturalearthdata)

#1. Import data
# Import 2017 baseline
LULC_ESA_2017<-rast("data/pnas_lulc_dist20240207a/lulc_esa_2017.tif")
LULC_ESA_2017

# Import Business as usual (BAU) scenario
BAU_PNAS<-rast("data/pnas_lulc_dist20240207a/pnas_lulc_seals5_gtap1_rcp45_ssp2_2030_BAU.tif")
BAU_PNAS

# Select german boundary
germany_sf<-ne_countries(scale="medium", country="Germany",returnclass ="sf")

# Ensure CRS consistency
germany_sf<-st_transform(germany_sf,crs=crs(LULC_ESA_2017))

# Convert the sf to a spatial object
germany_sp<-vect(germany_sf)

# Crop and mask the raster to Germany's boundary
LULC_ESA_2017_germany<-mask(crop(LULC_ESA_2017,germany_sp),germany_sp)
BAU_PNAS_2030_germany<-mask(crop(BAU_PNAS,germany_sp),germany_sp)
plot(LULC_ESA_2017_germany)
plot(BAU_PNAS_2030_germany)

# proceed with the rest of the analysis using the cropped and masked rasters
# Define the mapping from ESA LULC types to the 7 LULC types (SEALS)
value_to_land_use<-list(
  "190" = 1,  # Urban
  "10" = 2, "11" = 2, "12" = 2, "20" = 2, "30" = 2,  # Cropland
  "130" = 3,  # Pasture/Grassland
  "40" = 4, "50" = 4, "60" = 4, "61" = 4, "62" = 4, "70" = 4, "71" = 4, "72" = 4, "80" = 4, "81" = 4, "82" = 4, "90" = 4, "100" = 4,  # Forest
  "110" = 5, "120" = 5, "121" = 5, "122" = 5, "140" = 5,  # Non-forest vegetation
  "210" = 6,  # Water
  "150" = 7, "151" = 7, "152" = 7, "153" = 7, "160" = 7, "170" = 7, "180" = 7, "200" = 7, "201" = 7, "202" = 7, "210" =7, "220" = 7  # Barren or Other
)

# Function to map ESA LULC values to the 7 LULC types
map_values_to_land_use <- function(x) {
  sapply(x, function(val) {
    if (val %in% names(value_to_land_use)) {
      return(value_to_land_use[[as.character(val)]])
    } else {
      return(NA)  # Handle values that do not map to any land-use type
    }
  })
}

# Apply the mapping to the LULC_ESA_2017_germany raster
mapped_LULC_ESA_2017_germany <- app(LULC_ESA_2017_germany, fun = map_values_to_land_use)

